# Build output
build/
DerivedData/
*.xcuserstate

# Xcode project is generated by XcodeGen (see project.yml) and is
# machine-specific, so it is not committed. Note: a negation like
# "!*.xcodeproj/project.pbxproj" would NOT work here — git cannot re-include
# a file whose parent directory is already excluded.
*.xcodeproj/
*.xcworkspace/
xcuserdata/
*.xcscmblueprint
*.xccheckout

# Info.plist is likewise generated by XcodeGen from project.yml properties.
TougeTracker/Info.plist

# macOS
.DS_Store

# Bundled road data (152MB, 633 tiles). Generated by
# scripts/split-db-into-tiles.mjs from a sibling ../Tougefinder checkout
# and from its touges_db.json source database. Not tracked here — the data
# is large and belongs to the Tougefinder project. Run:
#   node scripts/split-db-into-tiles.mjs
# to regenerate it locally before building or running tests.
TougeTracker/Resources/tiles/

# Local agent tooling / personal notes, not project source.
.commandcode/

# Swift Package Manager
.build/
Packages/
Package.resolved
.swiftpm/

# Downloaded roadcurvature.com KMZ sources (regenerate with
# scripts/fetch-curvature-tiles.mjs)
.curvature-cache/
